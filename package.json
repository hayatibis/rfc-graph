  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/d3-quadtree": "^3.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
